<!-- app/views/accounts/index.html.erb -->
<p class="text-green-600 mb-4"><%= notice %></p>

<% content_for :title, "Accounts" %>

<h1 class="text-2xl font-bold mb-6">Accounts</h1>

<% @accounts_by_type.each do |type, roots| %>
  <section class="mb-8">
    <h2 class="text-xl font-bold mb-2"><%= Account::TYPE_LABELS[type] %></h2>
    <ul>
      <% roots.each do |account| %>
        <%= render "account_node", account: account, depth: 0 %>
      <% end %>
    </ul>
  </section>
<% end %>

<%= link_to "New account", new_account_path, class: "mt-8 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" %>
