<tr id="<%= dom_id account %>" class="border border-gray-300 text-center">
  <td class="border border-blue-300 px-3 py-2"><%= account.name %></td>
  <td class="border border-blue-300 px-3 py-2"><%= account.parent&.name || "—" %></td>
  <td class="border border-blue-300 px-3 py-2"><%= account.account_type.titleize %></td>
  <td class="border border-blue-300 px-3 py-2"><%= account.description %></td>
  <td class="border border-blue-300 px-3 py-2"><%= account.cash_flow_category&.titleize || "—" %></td>
  <td class="border border-blue-300 px-3 py-2">
    <%= link_to "Edit", edit_account_path(account), class: "text-blue-600 hover:underline mr-2" %>
    <%= link_to "Delete", account, method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
  </td>
</tr>
