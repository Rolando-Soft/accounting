<%= form_with(model: account, html: { class: "max-w-lg mx-auto bg-white p-8 rounded shadow", data: { controller: "account-type-fields" } }) do |form| %>
  <% if account.errors.any? %>
    <div class="mb-6 p-4 bg-red-100 border border-red-400 rounded">
      <h2 class="text-red-700 font-bold mb-2"><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>
      <ul class="list-disc list-inside text-red-600">
        <% account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :name, class: "block text-gray-700 font-semibold mb-1" %>
    <%= form.text_field :name, autofocus: true, class: "w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300" %>
  </div>

  <div class="mb-4">
    <%= form.label :account_type, class: "block text-gray-700 font-semibold mb-1" %>
    <%= form.select :account_type, Account.account_types.keys.map{ |key| [key.titleize, key] }, { }, class: "w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300", data: { "account-type-fields-target": "accountType", action: "change->account-type-fields#toggle" } %>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "block text-gray-700 font-semibold mb-1" %>
    <%= form.text_field :description, class: "w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300" %>
  </div>

  <div class="mb-4">
    <div class="flex items-center gap-1 mb-1">
      <%= form.label :cash_flow_category, class: "block text-gray-700 font-semibold" do %>
        Cash flow category <span class="text-red-600">*</span>
      <% end %>
      <div class="relative group">
        <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-gray-300 text-gray-700 text-xs font-bold cursor-help">?</span>
        <div class="hidden group-hover:block absolute z-10 left-0 top-full mt-1 w-80 max-h-[70vh] overflow-y-auto p-3 bg-gray-800 text-gray-100 text-xs rounded shadow-lg">
          <p class="mb-2">
            <span class="font-bold">Cash</span> <span class="italic">(Asset accounts only)</span>
          </p>
          <ul class="list-disc list-inside mb-3 space-y-0.5">
            <li>Checking, savings, and petty cash accounts themselves</li>
          </ul>
          <p class="mb-2">
            <span class="font-bold">Operating</span> <span class="italic">(Current Assets &amp; Current Liabilities)</span>
          </p>
          <ul class="list-disc list-inside mb-3 space-y-0.5">
            <li>Accounts Receivable</li>
            <li>Inventory</li>
            <li>Prepaid Expenses</li>
            <li>Accounts Payable</li>
            <li>Accrued Expenses (Wages, Taxes)</li>
            <li>Unearned Revenue</li>
            <li>Depreciation &amp; Amortization <span class="italic">(non-cash)</span></li>
          </ul>
          <p class="mb-2">
            <span class="font-bold">Investing</span> <span class="italic">(Long-Term Assets)</span>
          </p>
          <ul class="list-disc list-inside mb-3 space-y-0.5">
            <li>Property, Plant &amp; Equipment (PP&amp;E)</li>
            <li>Land &amp; Buildings</li>
            <li>Intangible Assets (Patents, Trademarks)</li>
            <li>Marketable Securities / Long-Term Investments</li>
            <li>Notes Receivable (loans made to others)</li>
          </ul>
          <p class="mb-2">
            <span class="font-bold">Financing</span> <span class="italic">(Long-Term Liabilities &amp; Equity)</span>
          </p>
          <ul class="list-disc list-inside space-y-0.5">
            <li>Notes Payable &amp; Bonds Payable</li>
            <li>Bank Loans / Lines of Credit</li>
            <li>Common &amp; Preferred Stock</li>
            <li>Additional Paid-in Capital</li>
            <li>Treasury Stock</li>
            <li>Retained Earnings <span class="italic">(specifically Dividends Paid)</span></li>
          </ul>
        </div>
      </div>
    </div>
    <% category_options = %w[cash operating investing financing].map do |key|
         html_options = key == "cash" ? { data: { "account-type-fields-target": "cashOption" } } : {}
         [key.titleize, key, html_options]
       end %>
    <%= form.select :cash_flow_category, options_for_select(category_options, account.cash_flow_category), { include_blank: "Select a category" }, { class: "w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300", required: true } %>
  </div>

  <div class="mb-4">
    <%= form.label :parent_id, "Parent account", class: "block text-gray-700 font-semibold mb-1" %>
    <div class="relative" data-controller="account-combobox">
      <%= form.collection_select :parent_id, Account.where.not(id: account.id).ordered_by_type, :id, :label_with_type, { include_blank: "None (top-level)" }, class: "hidden", data: { "account-combobox-target": "select" } %>
      <input type="text" class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300" placeholder="None (top-level)" autocomplete="off"
            data-account-combobox-target="input"
            data-action="input->account-combobox#search focus->account-combobox#open blur->account-combobox#close keydown.enter->account-combobox#selectTopMatch keydown.escape->account-combobox#close" />
      <ul class="hidden absolute z-10 bg-white border rounded shadow w-full mt-1 max-h-60 overflow-auto" data-account-combobox-target="list"></ul>
    </div>
  </div>

  <div>
    <%= form.submit class: "w-full bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>
