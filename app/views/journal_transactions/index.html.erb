<% content_for :title, "Journal Transactions" %>
<p class="text-green-600 mb-4"><%= notice %></p>
<p class="text-red-600 mb-4"><%= alert %></p>

<%= form_with url: journal_transactions_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-4" do |form| %>
  <%= link_to "New transaction", new_journal_transaction_path(return_to: @return_to), class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  <%= form.text_field :q, value: params[:q], placeholder: "Search by payee…", class: "border rounded px-3 py-2 w-72" %>
  <%= form.submit "Search", class: "bg-blue-500 text-white px-3 py-2 rounded hover:bg-blue-600" %>
  <% if params[:q].present? %>
    <%= link_to "Clear", journal_transactions_path, class: "text-blue-600 hover:underline" %>
  <% end %>
<% end %>

<table class="table-auto w-full">
  <thead>
    <tr>
      <th class="border border-blue-300 px-3 py-2">Date</th>
      <th class="border border-blue-300 px-3 py-2">Payee</th>
      <th class="border border-blue-300 px-3 py-2">Description</th>
      <th class="border border-blue-300 px-3 py-2">Entries</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "journal_transaction_row", collection: @journal_transactions, as: :transaction %>
  </tbody>
</table>
