<%
  entry = entry_form.object
  debit_value = entry.debit_amount || (entry.debit? ? number_with_precision(entry.amount, precision: 2, delimiter: ",") : nil)
  credit_value = entry.credit_amount || (entry.credit? ? number_with_precision(entry.amount, precision: 2, delimiter: ",") : nil)

  # Parent accounts can't hold entries (see Entry#account_must_not_have_children),
  # except an entry's own already-selected account, kept so editing an older
  # entry never silently loses its account.
  selectable_accounts = Account.ordered_by_type.postable.to_a
  if entry.account_id && selectable_accounts.none? { |a| a.id == entry.account_id }
    selectable_accounts << Account.find_by(id: entry.account_id)
    selectable_accounts.compact!
  end

  selectable_projects = Project.order(:name).to_a
  if entry.project_id && selectable_projects.none? { |p| p.id == entry.project_id }
    selectable_projects << Project.find_by(id: entry.project_id)
    selectable_projects.compact!
  end
%>
<div class="grid grid-cols-[2fr_2fr_1.5fr_1fr_1fr_auto_auto] gap-2 items-center mb-2" data-journal-form-target="row">
  <% if locked %>
    <%= entry_form.hidden_field :account_id %>
    <div class="border rounded px-3 py-2 bg-gray-100 text-gray-700"><%= entry.account&.name || "This account" %></div>
  <% else %>
    <div class="relative" data-controller="account-combobox">
      <%= entry_form.collection_select :account_id, selectable_accounts, :id, :label_with_type, { prompt: "Select Account" }, class: "hidden",
            data: { "account-combobox-target": "select" } %>
      <input type="text" class="border rounded px-3 py-2 w-full" placeholder="Select Account" autocomplete="off"
            data-account-combobox-target="input"
            data-action="input->account-combobox#search focus->account-combobox#open blur->account-combobox#close keydown.enter->account-combobox#selectTopMatch keydown.escape->account-combobox#close" />
      <ul class="hidden absolute z-10 bg-white border rounded shadow w-full mt-1 max-h-60 overflow-auto" data-account-combobox-target="list"></ul>
    </div>
  <% end %>

  <%= entry_form.text_field :description, class: "border rounded px-3 py-2 w-full" %>

  <%= entry_form.collection_select :project_id, selectable_projects, :id, :label, { include_blank: true },
        class: "border rounded px-3 py-2 w-full", data: { "journal-form-target": "projectLine" } %>

  <%= entry_form.text_field :debit_amount, value: debit_value, readonly: locked,
        class: "border rounded px-3 py-2 w-full #{"bg-gray-100 text-gray-700" if locked}",
        data: { "journal-form-target": locked ? "lockedDebit" : "debit", action: locked ? nil : "input->journal-form#recompute blur->journal-form#reformat" } %>

  <%= entry_form.text_field :credit_amount, value: credit_value, readonly: locked,
        class: "border rounded px-3 py-2 w-full #{"bg-gray-100 text-gray-700" if locked}",
        data: { "journal-form-target": locked ? "lockedCredit" : "credit", action: locked ? nil : "input->journal-form#recompute blur->journal-form#reformat" } %>

  <label class="flex items-center justify-center" title="Mark reconciled">
    <%= entry_form.check_box :mark_reconciled, checked: entry.reconciled?, class: "w-4 h-4" %>
  </label>

  <% if locked %>
    <span class="invisible font-bold px-2">x</span>
  <% else %>
    <button type="button" class="text-red-600 hover:text-red-800 font-bold px-2" title="Delete entry" data-action="click->journal-form#remove">x</button>
  <% end %>

  <% if entry.persisted? %>
    <%= entry_form.hidden_field :id %>
    <%= entry_form.hidden_field :_destroy, value: "0" %>
  <% end %>
</div>
