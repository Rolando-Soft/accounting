<% has_reconciled_entries = journal_transaction.entries.any? { |e| e.persisted? && e.reconciled? } %>

<% if journal_transaction.errors.any? %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
    <ul class="list-disc list-inside">
      <% journal_transaction.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if has_reconciled_entries %>
  <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-4">
    This transaction includes a reconciled entry. Changing or removing it will affect previously reconciled balances.
  </div>
<% end %>

<%= form_with(model: journal_transaction) do |form| %>
  <%= form.hidden_field :allow_reconciled_changes, value: "1" if has_reconciled_entries %>

  <div class="mb-4">
    <%= form.label :date, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.date_field :date, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :payee, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.text_field :payee, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.text_field :description, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div>
    <h3 class="text-lg font-bold mb-2">Entries</h3>
    <div id="entries" class="space-y-4">
      <%= form.fields_for :entries do |entry_form| %>
        <div class="border p-4 rounded bg-gray-50">
          <div class="mb-2">
            <%= entry_form.label :account_id, "Account", class: "block text-gray-700 font-bold mb-1" %>
            <%= entry_form.collection_select :account_id, Account.all, :id, :name, { prompt: "Select Account" }, class: "border rounded px-3 py-2 w-full" %>
          </div>
          <div class="mb-2">
            <%= entry_form.label :entry_type, class: "block text-gray-700 font-bold mb-1" %>
            <%= entry_form.select :entry_type, [['Debit', 'debit'], ['Credit', 'credit']], {}, class: "border rounded px-3 py-2 w-full" %>
          </div>
          <div class="mb-2">
            <%= entry_form.label :amount, class: "block text-gray-700 font-bold mb-1" %>
            <%= entry_form.number_field :amount, step: 0.01, class: "border rounded px-3 py-2 w-full" %>
          </div>
          <div class="mb-2">
            <%= entry_form.label :description, class: "block text-gray-700 font-bold mb-1" %>
            <%= entry_form.text_field :description, class: "border rounded px-3 py-2 w-full" %>
          </div>
          <div>
            <%= entry_form.label :reconciliation_status, class: "block text-gray-700 font-bold mb-1" %>
            <%= entry_form.select :reconciliation_status, Entry.reconciliation_statuses.keys.map { |s| [s.titleize, s] }, {}, class: "border rounded px-3 py-2 w-full" %>
          </div>
          <div class="text-right">
            <button type="button" class="remove-entry bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600">Remove Entry</button>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-4">
      <button type="button" id="add-entry" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Add Entry</button>
    </div>
  </div>

  <div class="flex items-center">
    <%= form.submit "Save Journal Transaction", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600",
          data: (has_reconciled_entries ? { turbo_confirm: "This transaction includes a reconciled entry. Saving changes will affect previously reconciled balances. Continue?" } : {}) %>
  </div>
<% end %>