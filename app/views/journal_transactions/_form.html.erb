<% has_reconciled_entries = journal_transaction.entries.any? { |e| e.persisted? && e.reconciled? } %>
<%
  matches, other_entries = journal_transaction.entries.partition { |e| @register_account_id && e.account_id == @register_account_id }
  locked_entry = matches.shift
  other_entries = matches + other_entries
  ordered_entries = [locked_entry, *other_entries].compact
%>

<% if journal_transaction.errors.any? %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
    <ul class="list-disc list-inside">
      <% journal_transaction.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if has_reconciled_entries %>
  <div class="bg-yellow-100 border border-yellow-400 text-yellow-800 px-4 py-3 rounded mb-4">
    This transaction includes a reconciled entry. Changing or removing it will affect previously reconciled balances.
  </div>
<% end %>

<%= form_with(model: journal_transaction) do |form| %>
  <%= form.hidden_field :allow_reconciled_changes, value: "1" if has_reconciled_entries %>
  <%= hidden_field_tag :register_account_id, @register_account_id if @register_account_id %>
  <%= hidden_field_tag :return_to, @return_to if @return_to %>

  <div class="mb-4">
    <%= form.label :date, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.date_field :date, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div class="mb-4 relative" data-controller="payee-autocomplete" data-payee-autocomplete-url-value="<%= payee_suggestions_journal_transactions_path %>">
    <%= form.label :payee, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.text_field :payee, class: "border rounded px-3 py-2 w-full", autocomplete: "off",
          data: { "payee-autocomplete-target": "input", action: "input->payee-autocomplete#search" } %>
    <ul class="hidden absolute z-10 bg-white border rounded shadow w-full mt-1" data-payee-autocomplete-target="list"></ul>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "block text-gray-700 font-bold mb-2" %>
    <%= form.text_field :description, class: "border rounded px-3 py-2 w-full" %>
  </div>

  <div data-controller="journal-form">
    <div class="mb-4 flex items-end gap-2">
      <div>
        <label class="block text-gray-700 font-bold mb-2">Project</label>
        <%= collection_select :header, :project_id, Project.order(:name), :id, :label, { include_blank: "Apply to all lines…" },
              class: "border rounded px-3 py-2", data: { "journal-form-target": "projectHeader", action: "change->journal-form#applyProjectToAllLines" } %>
      </div>
      <p class="text-sm text-gray-500 pb-2">Sets every line below to this project — each line can still be changed individually afterward.</p>
    </div>

    <h3 class="text-lg font-bold mb-2">Entries</h3>

    <div class="grid grid-cols-[2fr_2fr_1.5fr_1fr_1fr_auto_auto] gap-2 text-gray-700 font-bold mb-1 text-sm">
      <div>Account</div>
      <div>Description</div>
      <div>Project</div>
      <div>DB</div>
      <div>CR</div>
      <div class="text-center">R</div>
      <div><span class="invisible font-bold px-2">x</span></div>
    </div>

    <div data-journal-form-target="container">
      <%= form.fields_for :entries, ordered_entries do |entry_form| %>
        <%= render "entry_fields", entry_form: entry_form, locked: entry_form.object.equal?(locked_entry) %>
      <% end %>
    </div>

    <template data-journal-form-target="template">
      <%= form.fields_for :entries, Entry.new, child_index: "NEW_RECORD" do |entry_form| %>
        <%= render "entry_fields", entry_form: entry_form, locked: false %>
      <% end %>
    </template>

    <div class="mt-2">
      <button type="button" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" data-action="click->journal-form#add">Entry add</button>
    </div>

    <div class="grid grid-cols-[2fr_2fr_1.5fr_1fr_1fr_auto_auto] gap-2 items-center mt-4 font-bold">
      <div></div>
      <div class="text-right">Total</div>
      <div></div>
      <div data-journal-form-target="totalDebit">0.00</div>
      <div data-journal-form-target="totalCredit">0.00</div>
      <div></div>
      <div></div>
    </div>

    <div class="flex items-center gap-4 mt-4">
      <%= form.submit "Submit Journal Entry", class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 disabled:bg-gray-400 disabled:cursor-not-allowed",
            data: { "journal-form-target": "submit", turbo_confirm: (has_reconciled_entries ? "This transaction includes a reconciled entry. Saving changes will affect previously reconciled balances. Continue?" : nil) } %>

      <% if journal_transaction.persisted? %>
        <%= link_to "Delete transaction", journal_transaction_path(journal_transaction, return_to: @return_to),
              class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700",
              data: { turbo_method: :delete,
                turbo_confirm: has_reconciled_entries ? "This transaction includes a reconciled entry: deleting it will affect previously reconciled balances. Delete anyway?" : "Delete this transaction?" } %>
      <% end %>
    </div>
  </div>
<% end %>