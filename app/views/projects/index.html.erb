<% content_for :title, "Projects" %>
<h1 class="text-2xl font-bold mb-6">Projects</h1>

<% if notice.present? %>
  <p class="text-green-600 mb-4"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p class="text-red-600 mb-4"><%= alert %></p>
<% end %>

<%= link_to "New project", new_project_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 inline-block mb-4" %>

<table class="table-auto w-full">
  <thead>
    <tr>
      <th class="border border-blue-300 px-3 py-2 text-left">Name</th>
      <th class="border border-blue-300 px-3 py-2 text-left">Code</th>
      <th class="border border-blue-300 px-3 py-2 text-left">Status</th>
      <th class="border border-blue-300 px-3 py-2"></th>
    </tr>
  </thead>
  <tbody>
    <% @projects.each do |project| %>
      <tr class="border border-gray-300">
        <td class="border border-blue-300 px-3 py-2"><%= project.name %></td>
        <td class="border border-blue-300 px-3 py-2"><%= project.code %></td>
        <td class="border border-blue-300 px-3 py-2"><%= project.status.titleize %></td>
        <td class="border border-blue-300 px-3 py-2 text-center space-x-3">
          <%= link_to "Edit", edit_project_path(project), class: "text-blue-600 hover:underline" %>
          <%= button_to "Delete", project, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } },
                class: "text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer inline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
