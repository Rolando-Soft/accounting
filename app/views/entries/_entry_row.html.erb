<% other_entries = entry.journal_transaction.entries.reject { |e| e.id == entry.id } %>
<tr id="<%= dom_id(entry) %>" class="border border-gray-300 text-center">
  <td class="border border-blue-300 px-3 py-2"><%= entry.journal_transaction.date %></td>
  <td class="border border-blue-300 px-3 py-2"><%= entry.journal_transaction.payee %></td>
  <td class="border border-blue-300 px-3 py-2 text-left">
    <% other_entries.each do |other| %>
      <div><%= other.account.name %> <span class="text-gray-500">(<%= number_to_currency(other.amount) %>)</span></div>
    <% end %>
  </td>
  <td class="border border-blue-300 px-3 py-2"><%= entry.journal_transaction.description %></td>
  <td class="border border-blue-300 px-3 py-2"><%= number_to_currency(entry.amount) if entry.debit? %></td>
  <td class="border border-blue-300 px-3 py-2"><%= number_to_currency(entry.amount) if entry.credit? %></td>
  <td class="border border-blue-300 px-3 py-2">
    <%= form_with model: entry, url: entry_path(entry), method: :patch do |form| %>
      <%= hidden_field_tag :return_to, request.fullpath %>
      <%= form.hidden_field :reconciliation_status, value: entry.next_reconciliation_status %>
      <%= tag.button type: "submit",
            title: "#{entry.reconciliation_status.titleize} (click for #{entry.next_reconciliation_status.titleize})",
            class: "w-5 h-5 border-2 border-gray-500 rounded flex items-center justify-center mx-auto hover:border-blue-500",
            data: (entry.reconciled? ? { turbo_confirm: "This entry is reconciled. Changing its status will affect previously reconciled balances. Continue?" } : {}) do %>
        <% if entry.cleared? %>
          <%= tag.span "", class: "w-2.5 h-2.5 rounded-full bg-gray-700" %>
        <% elsif entry.reconciled? %>
          <%= tag.span "✓", class: "text-gray-700 text-xs leading-none font-bold" %>
        <% end %>
      <% end %>
    <% end %>
  </td>
</tr>
