<% content_for :title, "Register" %>
<p class="text-green-600 mb-4"><%= notice %></p>
<p class="text-red-600 mb-4"><%= alert %></p>

<%= form_with url: entries_path, method: :get, id: "register-filters", class: "mb-6 space-y-4" do |form| %>
  <div>
    <%= form.label :account_id, "Account", class: "block text-gray-700 font-bold mb-1" %>
    <div class="relative inline-block" data-controller="account-combobox">
      <%= form.collection_select :account_id, @accounts, :id, :label_with_type, { selected: @account&.id }, class: "hidden",
            onchange: "this.form.requestSubmit()", data: { "account-combobox-target": "select" } %>
      <input type="text" class="border rounded px-3 py-2 w-56" placeholder="Search account…" autocomplete="off"
            data-account-combobox-target="input"
            data-action="input->account-combobox#search focus->account-combobox#open blur->account-combobox#close keydown.enter->account-combobox#selectTopMatch keydown.escape->account-combobox#close" />
      <ul class="hidden absolute z-10 bg-white border rounded shadow w-56 mt-1 max-h-60 overflow-auto" data-account-combobox-target="list"></ul>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-6">
    <% if @account %>
      <div data-controller="keyboard-shortcut" data-keyboard-shortcut-key-value="n"
            data-keyboard-shortcut-url-value="<%= new_journal_transaction_path(register_account_id: @account.id, return_to: @return_to) %>">
        <%= link_to "New transaction (n)", new_journal_transaction_path(register_account_id: @account.id, return_to: @return_to), class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
      </div>
    <% end %>

    <div>
      <%= form.label :view_filter, "View Filter", class: "font-bold mr-2" %>
      <%= form.select :view_filter,
            [["This month", "this_month"], ["Last month", "last_month"], ["Last 3 months", "last_3_months"],
             ["This year", "this_year"], ["Last year", "last_year"], ["All dates", "all_dates"]],
            { selected: @view_filter }, class: "border rounded px-2 py-1", onchange: "this.form.requestSubmit()" %>
    </div>

    <div class="flex gap-4">
      <% EntriesController::STATUSES.each do |status| %>
        <label class="flex items-center gap-1">
          <%= check_box_tag "statuses[]", status, @selected_statuses.include?(status), id: "status_#{status}", onchange: "this.form.requestSubmit()" %>
          <%= status.titleize %>
        </label>
      <% end %>
    </div>
  </div>
<% end %>

<% if @account %>
  <% difference_is_zero = @difference.round(2).zero? %>
  <div class="flex flex-wrap items-end gap-10 mb-6" data-controller="difference">
    <%= render "balance_tile", id: "reconciled-balance-stat", amount: @reconciled_balance, label: "Reconciled" %>
    <%= render "balance_tile", id: "ticked-balance-stat", amount: @ticked_balance, label: "Ticked" %>
    <%= render "balance_tile", id: "computed-balance-stat", amount: @computed_balance, label: "Computed", difference_target: "computed" %>
    <div>
      <div class="text-xl font-bold">
        <%= text_field_tag :statement_balance, number_with_precision(@statement_balance, precision: 2, delimiter: ","), size: 10,
              class: "border rounded px-2 py-1 w-28", form: "register-filters",
              data: { "difference-target": "input", action: "input->difference#recompute blur->difference#reformatStatement" } %>
      </div>
      <div class="text-sm text-gray-600">Statement</div>
    </div>
    <%= render "balance_tile", id: "difference-stat", amount: @difference, label: "Difference", difference_target: "output" %>
    <div class="flex items-end gap-4">
      <%= render "balance_tile", id: "working-balance-stat", amount: @working_balance, label: "Working Balance" %>
      <%= form_with url: reconcile_entries_path, method: :post do |f| %>
        <%= hidden_field_tag :return_to, @return_to, id: "reconcile_return_to" %>
        <%= f.hidden_field :account_id, value: @account.id, id: "reconcile_account_id" %>
        <%= f.hidden_field :view_filter, value: @view_filter, id: "reconcile_view_filter" %>
        <%= f.hidden_field :statement_balance, value: @statement_balance, id: "reconcile_statement_balance", data: { "difference-target": "reconcileStatement" } %>
        <%= f.submit "Reconcile",
              disabled: !difference_is_zero,
              title: difference_is_zero ? "Finalize all ticked entries in this view as reconciled" : "Difference must be $0.00 before you can reconcile",
              data: { turbo_confirm: "Mark all ticked entries in this view as reconciled?", "difference-target": "reconcileButton" },
              class: "px-4 py-2 rounded text-white #{difference_is_zero ? "bg-green-600 hover:bg-green-700" : "bg-gray-400 cursor-not-allowed"}" %>
      <% end %>
    </div>
  </div>

  <table class="table-auto w-full">
    <thead>
      <tr>
        <th class="border border-blue-300 px-3 py-2">Date</th>
        <th class="border border-blue-300 px-3 py-2">Payee</th>
        <th class="border border-blue-300 px-3 py-2">Account</th>
        <th class="border border-blue-300 px-3 py-2">Description</th>
        <th class="border border-blue-300 px-3 py-2">Note</th>
        <th class="border border-blue-300 px-3 py-2">DB</th>
        <th class="border border-blue-300 px-3 py-2">CR</th>
        <th class="border border-blue-300 px-3 py-2">Status</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "entries/entry_row", collection: @entries, as: :entry %>
    </tbody>
  </table>
<% else %>
  <p class="text-gray-600">No asset or liability accounts yet. <%= link_to "Create one", new_account_path %>.</p>
<% end %>
