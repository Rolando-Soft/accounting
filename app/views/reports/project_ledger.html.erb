<% content_for :title, "Project Ledger" %>
<h1 class="text-2xl font-bold mb-6">Project Ledger</h1>

<%= form_with url: project_ledger_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-4" do |form| %>
  <div>
    <%= form.label :project_id, "Project", class: "font-bold mr-2" %>
    <%= form.collection_select :project_id, @projects, :id, :label, { selected: @project&.id }, class: "border rounded px-2 py-1", onchange: "this.form.requestSubmit()" %>
  </div>
  <%= render "reports/date_range_picker", form: form, date_range: @date_range, shift: @shift, custom_start: @custom_start, custom_end: @custom_end %>
<% end %>

<% if @project.nil? %>
  <p class="text-gray-600">No projects yet. <%= link_to "Create one", new_project_path %>.</p>
<% elsif @sections.empty? %>
  <p class="text-gray-600">No entries tagged to this project in this date range.</p>
<% else %>
  <% @sections.each do |section| %>
    <h2 class="font-bold text-lg mb-2"><%= section[:label] %></h2>

    <% section[:ledgers].each do |ledger| %>
      <h3 class="font-semibold text-gray-700 mb-1"><%= ledger[:account].name %></h3>
      <table class="table-auto w-full mb-4">
        <thead>
          <tr>
            <th class="border border-blue-300 px-3 py-2 whitespace-nowrap">Date</th>
            <th class="border border-blue-300 px-3 py-2">Payee</th>
            <th class="border border-blue-300 px-3 py-2">Other Account(s)</th>
            <th class="border border-blue-300 px-3 py-2">Description</th>
            <th class="border border-blue-300 px-3 py-2">Note</th>
            <th class="border border-blue-300 px-3 py-2">DB</th>
            <th class="border border-blue-300 px-3 py-2">CR</th>
            <th class="border border-blue-300 px-3 py-2">Balance</th>
          </tr>
        </thead>
        <tbody>
          <tr class="font-bold bg-gray-100">
            <td class="border border-blue-300 px-3 py-2" colspan="7">Beginning Balance</td>
            <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(ledger[:beginning_balance]) %></td>
          </tr>
          <%= render partial: "reports/ledger_row", collection: ledger[:rows], as: :row, locals: { account: ledger[:account] } %>
          <tr class="font-bold bg-gray-100">
            <td class="border border-blue-300 px-3 py-2" colspan="7">Ending Balance</td>
            <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(ledger[:ending_balance]) %></td>
          </tr>
        </tbody>
      </table>
    <% end %>

    <table class="table-auto w-full mb-6">
      <tbody>
        <tr class="font-bold bg-gray-50">
          <td class="border border-blue-300 px-3 py-2">Total <%= section[:label] %></td>
          <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(section[:total]) %></td>
        </tr>
      </tbody>
    </table>
  <% end %>
<% end %>
