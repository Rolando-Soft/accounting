<% content_for :title, "Balance Sheet" %>
<h1 class="text-2xl font-bold mb-6">Balance Sheet</h1>

<%= form_with url: balance_sheet_path, method: :get, class: "mb-6 flex items-center gap-4" do |form| %>
  <div class="flex items-center gap-2">
    <%= form.label :as_of, "As of", class: "font-bold" %>
    <%= form.date_field :as_of, value: @as_of, class: "border rounded px-3 py-2", onchange: "this.form.requestSubmit()" %>
  </div>
  <div class="flex items-center gap-2">
    <%= form.label :periods, "Compare", class: "font-bold" %>
    <%= form.select :periods,
          [["Single month", 1], ["Last 2 months", 2], ["Last 3 months", 3]],
          { selected: @periods }, class: "border rounded px-2 py-1", onchange: "this.form.requestSubmit()" %>
  </div>
  <label class="flex items-center gap-2 font-bold">
    <%= form.check_box :show_children, { checked: @show_children, onchange: "this.form.requestSubmit()" }, "1", "0" %>
    Show child accounts
  </label>
<% end %>

<table class="table-auto w-full mb-6">
  <thead>
    <tr>
      <th class="border border-blue-300 px-3 py-2 text-left">Account</th>
      <% @columns.each do |column| %>
        <th class="border border-blue-300 px-3 py-2 text-right"><%= column[:as_of].strftime("%b %-d, %Y") %></th>
      <% end %>
    </tr>
  </thead>
  <% [["asset", "Assets", :total_assets], ["liability", "Liabilities", :total_liabilities], ["equity", "Equity", :total_equity]].each do |type, label, total_key| %>
    <tbody>
      <tr class="bg-gray-100">
        <th colspan="<%= @columns.size + 1 %>" class="border border-blue-300 px-3 py-2 text-left"><%= label %></th>
      </tr>
      <% @trees[type].each do |row| %>
        <% next if row[:depth].positive? && !@show_children %>
        <% account = row[:account] %>
        <tr>
          <td class="border border-blue-300 px-3 py-2" style="padding-left: <%= 0.75 + row[:depth] * 1.5 %>rem">
            <%= link_to account.name, account_ledger_path(account_id: account.id), class: "text-blue-600 hover:underline" %>
          </td>
          <% @columns.each do |column| %>
            <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:rollups][type][account.id]) %></td>
          <% end %>
        </tr>
      <% end %>
      <% if type == "equity" %>
        <tr>
          <td class="border border-blue-300 px-3 py-2">Current Earnings <span class="text-gray-500 text-sm">(net income to date)</span></td>
          <% @columns.each do |column| %>
            <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:current_earnings]) %></td>
          <% end %>
        </tr>
      <% end %>
      <tr class="font-bold">
        <td class="border border-blue-300 px-3 py-2">Total <%= label %></td>
        <% @columns.each do |column| %>
          <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[total_key]) %></td>
        <% end %>
      </tr>
    </tbody>
  <% end %>
  <tbody>
    <tr class="font-bold border-t-4 border-gray-400">
      <td class="border border-blue-300 px-3 py-2">Liabilities + Equity</td>
      <% @columns.each do |column| %>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:total_liabilities] + column[:total_equity]) %></td>
      <% end %>
    </tr>
    <tr>
      <td class="border border-blue-300 px-3 py-2">Status</td>
      <% @columns.each do |column| %>
        <% difference = (column[:total_assets] - (column[:total_liabilities] + column[:total_equity])).round(2) %>
        <td class="border border-blue-300 px-3 py-2 text-right">
          <% if difference.zero? %>
            <span class="text-green-600">Balanced</span>
          <% else %>
            <span class="text-red-600">Off by <%= number_to_currency(difference) %></span>
          <% end %>
        </td>
      <% end %>
    </tr>
  </tbody>
</table>
