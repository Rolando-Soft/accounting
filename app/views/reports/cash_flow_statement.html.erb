<% content_for :title, "Cash Flow Statement" %>
<h1 class="text-2xl font-bold mb-6">Cash Flow Statement</h1>

<%= form_with url: cash_flow_statement_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-4" do |form| %>
  <%= render "reports/date_range_picker", form: form, date_range: @date_range, shift: @shift, custom_start: @custom_start, custom_end: @custom_end %>
  <label class="flex items-center gap-2 font-bold">
    <%= form.check_box :hide_zero_balances, { checked: @hide_zero_balances, onchange: "this.form.requestSubmit()" }, "1", "0" %>
    Hide zero-balance accounts
  </label>
<% end %>

<table class="table-auto w-full mb-6">
  <thead>
    <tr>
      <th class="border border-blue-300 px-3 py-2 text-left">Account</th>
      <% @columns.each do |column| %>
        <th class="border border-blue-300 px-3 py-2 text-right whitespace-nowrap"><%= column[:label] %></th>
      <% end %>
      <th class="border border-blue-300 px-3 py-2 text-right whitespace-nowrap">Total</th>
    </tr>
  </thead>
  <% [["operating", "Operating Activities"], ["investing", "Investing Activities"], ["financing", "Financing Activities"], ["uncategorized", "Uncategorized"]].each do |category, label| %>
    <% next if category == "uncategorized" && @columns.none? { |column| column[:category_rows][category].any? } %>
    <tbody>
      <tr class="bg-gray-100">
        <th colspan="<%= @columns.size + 2 %>" class="border border-blue-300 px-3 py-2 text-left"><%= label %></th>
      </tr>
      <% @columns.first[:category_rows][category].each_with_index do |(account, _effect), index| %>
        <% next if @hide_zero_balances && @columns.all? { |column| column[:category_rows][category][index][1].zero? } %>
        <tr>
          <td class="border border-blue-300 px-3 py-2"><%= account.name %></td>
          <% @columns.each do |column| %>
            <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:category_rows][category][index][1]) %></td>
          <% end %>
          <td class="border border-blue-300 px-3 py-2 text-right font-bold"><%= number_to_currency(@columns.sum { |column| column[:category_rows][category][index][1] }) %></td>
        </tr>
      <% end %>
      <tr class="font-bold">
        <td class="border border-blue-300 px-3 py-2">Net Cash from <%= label %></td>
        <% @columns.each do |column| %>
          <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:category_totals][category]) %></td>
        <% end %>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@columns.sum { |column| column[:category_totals][category] }) %></td>
      </tr>
    </tbody>
  <% end %>
  <tbody>
    <tr class="font-bold border-t-4 border-gray-400">
      <td class="border border-blue-300 px-3 py-2">Net Increase (Decrease) in Cash</td>
      <% @columns.each do |column| %>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:net_change]) %></td>
      <% end %>
      <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@columns.sum { |column| column[:net_change] }) %></td>
    </tr>
    <tr>
      <td class="border border-blue-300 px-3 py-2">Cash at Beginning of Period</td>
      <% @columns.each do |column| %>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:beginning_cash]) %></td>
      <% end %>
      <%# Not a sum: the Total column spans the whole selected range, so its "beginning" is the first month's. %>
      <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@columns.first[:beginning_cash]) %></td>
    </tr>
    <tr class="font-bold">
      <td class="border border-blue-300 px-3 py-2">Cash at End of Period</td>
      <% @columns.each do |column| %>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(column[:ending_cash]) %></td>
      <% end %>
      <%# Likewise, the range's "ending" is the last month's — summing balance snapshots across months would be meaningless. %>
      <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@columns.last[:ending_cash]) %></td>
    </tr>
    <tr>
      <td class="border border-blue-300 px-3 py-2">Status</td>
      <% @columns.each do |column| %>
        <% difference = (column[:beginning_cash] + column[:net_change] - column[:ending_cash]).round(2) %>
        <td class="border border-blue-300 px-3 py-2 text-right">
          <% if difference.zero? %>
            <span class="text-green-600">Reconciled</span>
          <% else %>
            <span class="text-red-600">Off by <%= number_to_currency(difference) %></span>
          <% end %>
        </td>
      <% end %>
      <% overall_difference = (@columns.first[:beginning_cash] + @columns.sum { |column| column[:net_change] } - @columns.last[:ending_cash]).round(2) %>
      <td class="border border-blue-300 px-3 py-2 text-right">
        <% if overall_difference.zero? %>
          <span class="text-green-600">Reconciled</span>
        <% else %>
          <span class="text-red-600">Off by <%= number_to_currency(overall_difference) %></span>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<p class="text-gray-500 text-sm">
  "Uncategorized" accounts have no Operating/Investing/Financing tag set — assign one on the
  <%= link_to "account", accounts_path, class: "text-blue-600 hover:underline" %> to move them into the right section above.
</p>
