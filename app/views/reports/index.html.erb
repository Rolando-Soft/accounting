<% content_for :title, "Reports" %>
<h1 class="text-2xl font-bold mb-6">Reports</h1>

<div class="space-y-6">
  <div>
    <h2 class="font-bold text-gray-700 mb-2">Financial Position</h2>
    <ul class="space-y-2">
      <li><%= link_to "Balance Sheet", balance_sheet_path, class: "text-blue-600 hover:underline" %></li>
    </ul>
  </div>

  <div>
    <h2 class="font-bold text-gray-700 mb-2">Income &amp; Spending</h2>
    <ul class="space-y-2">
      <li><%= link_to "Income Statement", income_statement_path, class: "text-blue-600 hover:underline" %></li>
      <li><%= link_to "Expense Treemap", expense_treemap_path, class: "text-blue-600 hover:underline" %></li>
      <li><%= link_to "Income/Expense Comparison", income_expense_comparison_path, class: "text-blue-600 hover:underline" %></li>
    </ul>
  </div>

  <div>
    <h2 class="font-bold text-gray-700 mb-2">Cash Flow</h2>
    <ul class="space-y-2">
      <li><%= link_to "Cash Flow Statement", cash_flow_statement_path, class: "text-blue-600 hover:underline" %></li>
      <li><%= link_to "Cash Flow Diagram", cash_flow_diagram_path, class: "text-blue-600 hover:underline" %></li>
      <li><%= link_to "Funds Flow Diagram", funds_flow_diagram_path, class: "text-blue-600 hover:underline" %></li>
    </ul>
  </div>

  <div>
    <h2 class="font-bold text-gray-700 mb-2">Ledgers &amp; Detail</h2>
    <ul class="space-y-2">
      <li><%= link_to "Account Ledger", account_ledger_path, class: "text-blue-600 hover:underline" %></li>
    </ul>
  </div>
</div>
