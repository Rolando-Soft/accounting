<% content_for :title, "Funds Flow Diagram" %>
<h1 class="text-2xl font-bold mb-6">Funds Flow Diagram</h1>

<%= form_with url: funds_flow_diagram_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-6" do |form| %>
  <div>
    <%= form.label :view_filter, "View Filter", class: "font-bold mr-2" %>
    <%= form.select :view_filter,
          [["This month", "this_month"], ["Last month", "last_month"], ["Last 3 months", "last_3_months"],
           ["This year", "this_year"], ["Last year", "last_year"], ["All dates", "all_dates"]],
          { selected: @view_filter }, class: "border rounded px-2 py-1", onchange: "this.form.requestSubmit()" %>
  </div>
<% end %>

<% if @flows.any? %>
  <div data-controller="sankey-chart" data-sankey-chart-flows-value="<%= @flows.to_json %>" style="height: 480px;" class="mb-6">
    <canvas data-sankey-chart-target="canvas"></canvas>
  </div>
<% else %>
  <p class="text-gray-600">No income or expense activity in this date range.</p>
<% end %>
