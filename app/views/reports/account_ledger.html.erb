<% content_for :title, "Account Ledger" %>
<h1 class="text-2xl font-bold mb-6">Account Ledger</h1>

<%= form_with url: account_ledger_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-6" do |form| %>
  <div>
    <%= form.label :account_id, "Account", class: "block text-gray-700 font-bold mb-1" %>
    <div class="relative inline-block" data-controller="account-combobox">
      <%= form.collection_select :account_id, @accounts, :id, :label_with_type, { selected: @account&.id }, class: "hidden",
            onchange: "this.form.requestSubmit()", data: { "account-combobox-target": "select" } %>
      <input type="text" class="border rounded px-3 py-2 w-56 h-[42px]" placeholder="Search account…" autocomplete="off"
            data-account-combobox-target="input"
            data-action="input->account-combobox#search focus->account-combobox#open blur->account-combobox#close keydown.enter->account-combobox#selectTopMatch keydown.escape->account-combobox#close" />
      <ul class="hidden absolute z-10 bg-white border rounded shadow w-56 mt-1 max-h-60 overflow-auto" data-account-combobox-target="list"></ul>
    </div>
  </div>

  <div>
    <div class="block font-bold mb-1 invisible" aria-hidden="true">Range</div>
    <%= render "reports/date_range_picker", form: form, date_range: @date_range, shift: @shift, custom_start: @custom_start, custom_end: @custom_end %>
  </div>

  <div>
    <%= form.label :project_id, "Project", class: "block text-gray-700 font-bold mb-1" %>
    <%= form.collection_select :project_id, @projects, :id, :label, { selected: @project&.id, include_blank: "All projects" },
          class: "border rounded px-3 py-2 h-[42px]", onchange: "this.form.requestSubmit()" %>
  </div>
<% end %>

<% if @account %>
  <table class="table-auto w-full">
    <thead>
      <tr>
        <th class="border border-blue-300 px-3 py-2 whitespace-nowrap">Date</th>
        <th class="border border-blue-300 px-3 py-2">Payee</th>
        <th class="border border-blue-300 px-3 py-2">Other Account(s)</th>
        <th class="border border-blue-300 px-3 py-2">Description</th>
        <th class="border border-blue-300 px-3 py-2">Note</th>
        <th class="border border-blue-300 px-3 py-2">DB</th>
        <th class="border border-blue-300 px-3 py-2">CR</th>
        <th class="border border-blue-300 px-3 py-2">Balance</th>
      </tr>
    </thead>
    <tbody>
      <tr class="font-bold bg-gray-100">
        <td class="border border-blue-300 px-3 py-2" colspan="7">Beginning Balance</td>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@beginning_balance) %></td>
      </tr>
      <%= render partial: "reports/ledger_row", collection: @rows, as: :row %>
      <tr class="font-bold bg-gray-100">
        <td class="border border-blue-300 px-3 py-2" colspan="7">Ending Balance</td>
        <td class="border border-blue-300 px-3 py-2 text-right"><%= number_to_currency(@ending_balance) %></td>
      </tr>
    </tbody>
  </table>
<% else %>
  <p class="text-gray-600">No accounts yet. <%= link_to "Create one", new_account_path %>.</p>
<% end %>
